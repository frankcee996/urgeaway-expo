{
  "expo": {
    "name": "UrgeAway",
    "slug": "urgeaway",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "urgeaway",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0c1626"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ceeenterprise.UrgeAway"
    },
    "android": {
      "package": "com.ceeenterprise.UrgeAway",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c1626"
      },
      "permissions": []
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "./plugins/withWebAssets.js"
    ],
    "extra": {
      "eas": {
        "projectId": "2797fc46-c742-4e2e-b24d-14f5deeb707c"
      }
    },
    "owner": "ceeabells-team"
  }
}
