<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/quick_widget_bg">

    <ImageView
        android:id="@+id/quick_widget_logo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/quick_widget_logo"
        android:contentDescription="@string/quick_widget_logo_desc" />

    <TextView
        android:id="@+id/quick_widget_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:text="@string/quick_widget_preview"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="3"
        android:ellipsize="end" />
</LinearLayout>
