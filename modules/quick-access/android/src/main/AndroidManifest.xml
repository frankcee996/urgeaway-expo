<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Quick Settings tile: "I have an urge" -->
        <service
            android:name="com.urgeaway.quickaccess.UrgeTileService"
            android:exported="true"
            android:icon="@drawable/quick_ic_tile_urge"
            android:label="@string/quick_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Home-screen encouragement widget -->
        <receiver
            android:name="com.urgeaway.quickaccess.UrgeAwayWidgetProvider"
            android:exported="true"
            android:label="@string/quick_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_widget_info" />
        </receiver>
    </application>
</manifest>
